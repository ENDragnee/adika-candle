generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Auth (better-auth) — core tables required by the prisma adapter.
// ---------------------------------------------------------------------------

model User {
  id              String    @id @default(cuid())
  name            String
  email           String    @unique
  emailVerified   Boolean   @default(false)
  image           String?
  username        String?   @unique
  displayUsername String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  roleId String?
  role   Role?   @relation(fields: [roleId], references: [id])

  sessions Session[]
  accounts Account[]
  logs     Log[]

  @@map("user")
}

model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("session")
}

model Account {
  id         String  @id @default(cuid())
  accountId  String
  providerId String
  userId     String
  user       User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("account")
}

model Verification {
  id         String    @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime? @default(now())
  updatedAt  DateTime? @updatedAt

  @@map("verification")
}

// ---------------------------------------------------------------------------
// RBAC — two seeded roles (Manager, Inventory Manager) but modeled as data
// so the Manager can manage permission assignments from the UI.
// ---------------------------------------------------------------------------

model Module {
  id          String       @id @default(cuid())
  name        String       @unique
  permissions Permission[]

  @@map("module")
}

model Permission {
  id   String @id @default(cuid())
  name String @unique

  moduleId String
  module   Module @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  roles Role[] @relation("RolePermissions")

  @@map("permission")
}

model Role {
  id          String       @id @default(cuid())
  name        String       @unique
  description String?
  permissions Permission[] @relation("RolePermissions")
  users       User[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("role")
}

// ---------------------------------------------------------------------------
// Catalog — categories, products, and price history (pricing is variable
// over time, never a single current-price field; see AGENTS.md).
// ---------------------------------------------------------------------------

model Category {
  id          String    @id @default(cuid())
  name        String    @unique
  description String?
  isActive    Boolean   @default(true)
  products    Product[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@map("category")
}

model Product {
  id                 String             @id @default(cuid())
  name               String
  sku                String             @unique
  isActive           Boolean            @default(true)
  categoryId         String
  category           Category           @relation(fields: [categoryId], references: [id])
  prices             Price[]
  stockBalance       StockBalance?
  stockLedgerEntries StockLedgerEntry[]
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  @@map("product")
}

model Price {
  id            String    @id @default(cuid())
  productId     String
  product       Product   @relation(fields: [productId], references: [id])
  amountPerKg   Decimal
  effectiveFrom DateTime  @default(now())
  effectiveTo   DateTime?
  createdById   String
  createdAt     DateTime  @default(now())

  @@index([productId, effectiveFrom])
  @@map("price")
}

// ---------------------------------------------------------------------------
// Unit conversions — Carton/Packet/Wax/Kir → KG ratios, Manager-editable at
// runtime. unitName is a plain string, not an enum (see docs/DECISIONS.md,
// 2026-11-07, "UnitConversion.unitName is a string, not a Prisma enum").
// ---------------------------------------------------------------------------

model UnitConversion {
  id        String   @id @default(cuid())
  unitName  String   @unique
  ratioToKg Decimal
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("unit_conversion")
}

// ---------------------------------------------------------------------------
// Stock — append-only ledger + cached balance (hybrid, see docs/DECISIONS.md,
// 2026-11-07 "Stock and loan balances: cached column + append-only ledger").
// Only the inbound ACCEPT side is written here; SALE decrement is Epic 6's
// job even though it writes into these same tables.
// ---------------------------------------------------------------------------

enum StockEntryType {
  ACCEPT
  SALE
  ADJUSTMENT
}

model StockBalance {
  id         String   @id @default(cuid())
  productId  String   @unique
  product    Product  @relation(fields: [productId], references: [id])
  quantityKg Decimal  @default(0)
  updatedAt  DateTime @updatedAt

  @@map("stock_balance")
}

model StockLedgerEntry {
  id             String         @id @default(cuid())
  productId      String
  product        Product        @relation(fields: [productId], references: [id])
  type           StockEntryType
  quantityKg     Decimal
  balanceAfterKg Decimal
  inputQuantity  Decimal?
  inputUnitName  String?
  inputRatioToKg Decimal?
  note           String?
  saleId         String?        @unique
  createdById    String
  createdAt      DateTime       @default(now())

  @@index([productId, createdAt])
  @@map("stock_ledger_entry")
}

// ---------------------------------------------------------------------------
// Audit log — written from auth and domain events.
// ---------------------------------------------------------------------------

enum LogSeverity {
  INFO
  WARN
  ERROR
}

model Log {
  id       String      @id @default(cuid())
  type     String
  severity LogSeverity
  message  String

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@map("log")
}
